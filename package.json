{
  "name": "IssieBoard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=issieboardDebug",
    "android:issieboard": "react-native run-android --mode=issieboardDebug",
    "android:issievoice": "react-native run-android --mode=issievoiceDebug",
    "ios": "npm run build:keyboards && react-native run-ios",
    "ios:issieboard": "npm run build:keyboards && react-native run-ios --scheme IssieBoardNG",
    "ios:issievoice": "npm run build:keyboards && react-native run-ios --scheme IssieVoice",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "test:android": "cd android && ./gradlew :app:testDebugUnitTest",
    "test:ios": "cd ios && xcodebuild test -workspace IssieBoardNG.xcworkspace -scheme IssieBoardNG -destination 'platform=iOS Simulator,name=iPhone 17' -quiet",
    "build:dictionaries": "node scripts/build_dictionaries.js",
    "build:keyboards": "node scripts/build_keyboard_configs.js",
    "build:keyboard-neighbors": "node scripts/build_keyboard_neighbors.js",
    "build:all": "npm run build:dictionaries && npm run build:keyboards && npm run build:keyboard-neighbors",
    "open:android-sim": "~/Library/Android/sdk/emulator/emulator -avd Pixel_3a &",
    "deploy:android:issieboard": "scripts/deploy-android.sh issieboard",
    "deploy:android:issievoice": "scripts/deploy-android.sh issievoice",
    "deploy:android:issiecalc": "scripts/deploy-android.sh issiecalc",
    "deploy:ios": "bash scripts/deploy-ios.sh",
    "deploy:ios:issieboard": "bash scripts/deploy-ios.sh beta app:issieboard",
    "deploy:ios:issievoice": "bash scripts/deploy-ios.sh beta app:issievoice",
    "deploy:ios:issiecalc": "bash scripts/deploy-ios.sh beta app:issiecalc",
    "postinstall": "patch-package",
    "e2e:build:ios:board": "detox build -c board.ipad",
    "e2e:build:android:board": "detox build -c board.android.phone",
    "e2e:build:ios:voice": "detox build -c voice.ipad",
    "e2e:build:android:voice": "detox build -c voice.android.phone",
    "e2e:build:ios:calc": "detox build -c calc.ipad",
    "e2e:build:android:calc": "detox build -c calc.android.phone",
    "e2e:ipad": "bash scripts/e2e.sh ipad",
    "e2e:iphone": "bash scripts/e2e.sh iphone",
    "e2e:android:phone": "bash scripts/e2e.sh android.phone",
    "e2e:android:tablet": "bash scripts/e2e.sh android.tablet",
    "e2e:android:device": "bash scripts/e2e.sh android.device"
  },
  "dependencies": {
    "@bam.tech/react-native-screen-sizer": "^0.3.2",
    "@beitissieshapiro/issie-shared": "^1.0.10",
    "@react-native-firebase/analytics": "^24.0.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/app-check": "^24.0.0",
    "@react-native-firebase/functions": "^24.0.0",
    "@react-native-vector-icons/ant-design": "^12.5.0",
    "@react-native-vector-icons/ionicons": "^12.5.0",
    "@react-native-vector-icons/material-design-icons": "^12.5.0",
    "@react-native-vector-icons/material-icons": "^12.5.0",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.7.1",
    "advanced-calculator": "^1.4.1",
    "js-yaml": "^4.1.1",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-default-preference": "^1.4.4",
    "react-native-device-info": "^15.0.2",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.33.1",
    "react-native-localize": "^3.7.0",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-share": "^12.2.0",
    "react-native-text-measure": "^1.0.2",
    "react-native-tts": "^4.1.1",
    "react-native-wheel-color-picker": "^1.3.1",
    "react-native-zip-archive": "^7.0.2",
    "rn-emoji-keyboard": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "2.8.8",
    "react-native-asset": "^2.2.8",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.3"
  }
}
